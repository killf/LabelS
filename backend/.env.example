# 固定的登录签名与数据源凭据加密密钥；请自行生成。
PASSWORD_SECRET_KEY=

# SQLite 目录在 K8s 中挂载 PVC。
DATABASE_URL=sqlite:///data/labelu.sqlite

# 上传图片和缩略图的全局 S3 存储；桶需提前创建。
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=labels
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
S3_USE_SSL=false

# AI 使用任务选定的 S3 YOLO 权重；需要已有的 Ultralytics/PyTorch 环境。
AI_AUTO_LABEL_ENABLED=true
AI_DEVICE=
