# 默认数据目录为用户主目录下的 .yolo-mcp，可按需覆盖。
# DATA_DIR=~/.yolo-mcp

# 默认 SQLite 位于 DATA_DIR/labels.sqlite，可按需指定其他数据库。
# DATABASE_URL=sqlite:///your/custom/labels.sqlite

# 签名密钥首次启动时自动生成到 DATA_DIR/secret.key，后续启动复用。

# AI 和页面训练复用当前 Python 的 GPU 环境；留空自动选择设备。
USE_AUTO_LABEL=true
DEVICE=

# MCP 默认只接受本机地址。远程部署时填写实际域名与来源的 JSON 数组。
# MCP_ALLOWED_HOSTS=["yolo.example.com"]
# MCP_ALLOWED_ORIGINS=["https://yolo.example.com"]
